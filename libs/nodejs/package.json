{
  "name": "jisr",
  "version": "0.0.1",
  "author": "Amine Ben Hammou <webneat@gmail.com>",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo 'No tests yet'",
    "build": "tsup",
    "prepublish": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.2.18",
    "@types/node": "^22.15.29",
    "prettier": "^3.5.3",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "tsup": {
    "entry": [
      "src/**/*.ts"
    ],
    "format": [
      "esm",
      "cjs"
    ],
    "dts": true,
    "bundle": false,
    "skipNodeModulesBundle": true,
    "outDir": "dist",
    "clean": true
  },
  "prettier": {
    "semi": false,
    "tabWidth": 2,
    "useTabs": false,
    "printWidth": 155,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "private": true
}
